[Unit]
Description=Water Meter Reader (ESP32-CAM + Coral TPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/water-meter-reader
ExecStart=/usr/bin/python3 /home/pi/water-meter-reader/meter_reader.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
